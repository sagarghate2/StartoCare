# Copy values into your local environment; never commit real credentials.
DB_URL=jdbc:postgresql://localhost:5432/startocare_users
DB_USERNAME=replace_with_your_postgres_username
DB_PASSWORD=replace_with_your_postgres_password
# Generate a fresh 32-byte (or longer) Base64-encoded secret for each environment.
JWT_SECRET=replace_with_a_base64_encoded_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=3600000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address
MAIL_PASSWORD=your_16_character_google_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
